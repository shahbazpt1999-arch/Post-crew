# Copy these into Vercel > Project > Settings > Environment Variables
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Publishable key (sb_publishable_...) or legacy anon key
SUPABASE_ANON_KEY=
# Secret key (sb_secret_...) or legacy service_role key
SUPABASE_SERVICE_ROLE_KEY=
# AI: set ONE of these. With none, the app runs in demo mode (sample posts).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Free option for testing (Google AI Studio). Claude is used if both are set.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
SITE_URL=https://your-app.vercel.app
